
#include <WiFi.h>
#include <PubSubClient.h>
#include <DHTesp.h>

// Wi-Fi settings for Wokwi
const char* WIFI_NAME = "Wokwi-GUEST";
const char* WIFI_PASSWORD = "";

// MQTT broker settings
const char* MQTT_SERVER = "broker.hivemq.com";
const int MQTT_PORT = 1883;
const char* MQTT_TOPIC = "aarthi-iot/task03/temperature";

const int DHT_PIN = 15;
const unsigned long READ_INTERVAL = 5000;
const unsigned long WIFI_RETRY_INTERVAL = 5000;
const unsigned long MQTT_RETRY_INTERVAL = 3000;
const unsigned long SEND_INTERVAL = 250;

// Offline buffer
const int BUFFER_SIZE = 20;
String bufferData[BUFFER_SIZE];
int head = 0;
int tail = 0;
int count = 0;

WiFiClient wifiClient;
PubSubClient mqtt(wifiClient);
DHTesp dhtSensor;

unsigned long lastRead = 0;
unsigned long lastWiFiAttempt = 0;
unsigned long lastMQTTAttempt = 0;
unsigned long lastSend = 0;

// Add a reading to the offline buffer
void saveReading(String message) {
  if (count == BUFFER_SIZE) {
    // Buffer full: remove the oldest reading
    head = (head + 1) % BUFFER_SIZE;
    count--;
    Serial.println("Buffer full: oldest reading removed");
  }

  bufferData[tail] = message;
  tail = (tail + 1) % BUFFER_SIZE;
  count++;

  Serial.print("Reading buffered. Queue size: ");
  Serial.println(count);
}

// Start or retry Wi-Fi connection
void maintainWiFi(unsigned long now) {
  if (WiFi.status() == WL_CONNECTED) {
    return;
  }

  if (now - lastWiFiAttempt >= WIFI_RETRY_INTERVAL) {
    lastWiFiAttempt = now;
    Serial.println("Trying Wi-Fi connection...");
    WiFi.begin(WIFI_NAME, WIFI_PASSWORD);
  }
}

// Start or retry MQTT connection
void maintainMQTT(unsigned long now) {
  if (WiFi.status() != WL_CONNECTED || mqtt.connected()) {
    return;
  }

  if (now - lastMQTTAttempt >= MQTT_RETRY_INTERVAL) {
    lastMQTTAttempt = now;

    Serial.println("Trying MQTT connection...");

    String clientId = "ESP32-Task03-" +
                      String((uint32_t)ESP.getEfuseMac(), HEX);

    if (mqtt.connect(clientId.c_str())) {
      Serial.println("MQTT connected!");
    } else {
      Serial.print("MQTT failed. State: ");
      Serial.println(mqtt.state());
    }
  }
}

// Read temperature and humidity
void readSensor(unsigned long now) {
  if (now - lastRead < READ_INTERVAL) {
    return;
  }

  lastRead = now;

  TempAndHumidity data = dhtSensor.getTempAndHumidity();

  if (isnan(data.temperature) || isnan(data.humidity)) {
    Serial.println("Sensor reading failed");
    return;
  }

  String message = "{\"temperature\":" +
                   String(data.temperature, 1) +
                   ",\"humidity\":" +
                   String(data.humidity, 1) + "}";

  Serial.print("New reading: ");
  Serial.println(message);

  // Always queue first so offline readings are preserved
  saveReading(message);
}

// Send the oldest buffered reading
void sendBufferedReading(unsigned long now) {
  if (!mqtt.connected() || count == 0) {
    return;
  }

  if (now - lastSend < SEND_INTERVAL) {
    return;
  }

  lastSend = now;

  if (mqtt.publish(MQTT_TOPIC, bufferData[head].c_str())) {
    Serial.print("Published: ");
    Serial.println(bufferData[head]);

    head = (head + 1) % BUFFER_SIZE;
    count--;
  } else {
    Serial.println("Publish failed. Reading kept in buffer.");
  }
}

void setup() {
  Serial.begin(115200);

  dhtSensor.setup(DHT_PIN, DHTesp::DHT22);

  mqtt.setServer(MQTT_SERVER, MQTT_PORT);
  mqtt.setBufferSize(256);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_NAME, WIFI_PASSWORD);

  Serial.println("Task 03 started");
}

void loop() {
  unsigned long now = millis();

  maintainWiFi(now);
  maintainMQTT(now);

  if (mqtt.connected()) {
    mqtt.loop();
  }

  readSensor(now);
  sendBufferedReading(now);
}
